-- PluginScript: Generate Typed Instance from selected instance

-- Services
local Selection = game:GetService("Selection")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Toolbar and button
local toolbar = plugin:CreateToolbar("Typed Instance Generator")
local button = toolbar:CreateButton("Generate Types", "Generate typed Luau table for selected instance", "")

-- Build a tree with both class and children
local function buildTypedTree(instance)
	local node = {
		ClassName = instance.ClassName,
		Children = {}
	}
	for _, child in ipairs(instance:GetChildren()) do
		node.Children[child.Name] = buildTypedTree(child)
	end
	return node
end

-- Format type tree correctly
local function formatTypeTree(name, node, indent, isRoot)
	indent = indent or ""
	isRoot = isRoot == nil and true or isRoot

	local lines = {}

	local openLine
	if isRoot then
		openLine = string.format("%s%s = %s & {", indent, name, node.ClassName)
	else
		openLine = string.format("%s%s: %s & {", indent, name, node.ClassName)
	end
	table.insert(lines, openLine)

	-- Sort keys for deterministic output
	local keys = {}
	for k in pairs(node.Children) do table.insert(keys, k) end
	table.sort(keys, function(a,b)
		if tonumber(a) and tonumber(b) then return tonumber(a) < tonumber(b) end
		return tostring(a) < tostring(b)
	end)

	for _, childName in ipairs(keys) do
		local childNode = node.Children[childName]
		local keyName = tonumber(childName) and string.format("[\"%s\"]", childName) or childName

		-- If no children, just type the class
		if next(childNode.Children) == nil then
			table.insert(lines, string.format("%s    %s: %s,", indent, keyName, childNode.ClassName))
		else
			-- Recursive for children
			local nested = formatTypeTree(keyName, childNode, indent .. "    ", false)
			for _, line in ipairs(nested) do table.insert(lines, line) end
		end
	end

	table.insert(lines, indent .. (isRoot and "}" or "},"))
	return lines
end

-- Button click
button.Click:Connect(function()
	local selection = Selection:Get()
	if #selection == 0 then
		warn("Select an instance to generate types!")
		return
	end

	local root = selection[1]

	local typedTree = buildTypedTree(root)
	local lines = formatTypeTree(root.Name, typedTree, "", true)

	local header = {
		"-- GENERATED Instance TYPE",
		"-- Copy this block into your Luau type annotations",
		"-- This gives autocomplete for descendants similar to Roblox Studio Explorer",
		"-- Generated by Typed Instance Plugin",
		"--[["
	}
	local footer = {"--]]"}

	local full = {}
	for _, l in ipairs(header) do table.insert(full, l) end
	for _, l in ipairs(lines) do table.insert(full, l) end
	for _, l in ipairs(footer) do table.insert(full, l) end

	local outputText = table.concat(full, "\n")

	local folder = ReplicatedStorage:FindFirstChild("GeneratedTypes") or Instance.new("Folder")
	if folder.Parent == nil then
		folder.Name = "GeneratedTypes"
		folder.Parent = ReplicatedStorage
	end

	local module = Instance.new("ModuleScript")
	module.Name = "TypedInstance_" .. math.random(1, 999999)
	module.Source = outputText
	module.Parent = folder

	print("✅ Typed Instance ModuleScript created in ReplicatedStorage.GeneratedTypes")
end)
