-- PluginScript: Generate Typed Instance from selected instance

-- Services
local Selection = game:GetService("Selection")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Toolbar and button
local toolbar = plugin:CreateToolbar("Typed Instance Generator")
local button = toolbar:CreateButton("Generate Types", "Generate typed Luau table for selected instance", "")

-- Typed tree builder
local function buildTypedTree(parent)
	local tree = {}
	for _, child in ipairs(parent:GetChildren()) do
		tree[child.Name] = buildTypedTree(child)
		if next(tree[child.Name]) == nil then
			tree[child.Name] = child.ClassName
		end
	end
	return tree
end

-- Type formatter with numeric key handling
local function formatTypeTree(name, tree, rootClass, indent, isRoot)
	indent = indent or ""
	isRoot = isRoot == nil and true or isRoot
	rootClass = rootClass or "Instance"  -- <- Use Instance for any type

	local lines = {}
	if isRoot then
		table.insert(lines, string.format("%s%s = %s & {", indent, name, rootClass))
	else
		table.insert(lines, string.format("%s%s: %s & {", indent, name, rootClass))
	end

	local keys = {}
	for k in pairs(tree) do table.insert(keys, k) end
	table.sort(keys, function(a,b)
		if tonumber(a) and tonumber(b) then return tonumber(a) < tonumber(b) end
		return tostring(a) < tostring(b)
	end)

	for _, k in ipairs(keys) do
		local v = tree[k]
		local keyName = k
		if tonumber(k) then
			keyName = string.format("[\"%s\"]", k)
		end
		if type(v) == "table" then
			local nested = formatTypeTree(keyName, v, nil, indent.."    ", false)
			for _, line in ipairs(nested) do table.insert(lines, line) end
		else
			table.insert(lines, string.format("%s    %s: %s,", indent, keyName, v))
		end
	end

	if isRoot then
		table.insert(lines, string.format("%s}", indent))
	else
		table.insert(lines, string.format("%s},", indent))
	end

	return lines
end

-- Button click
button.Click:Connect(function()
	local selection = Selection:Get()
	if #selection == 0 then
		warn("Select an instance to generate types!")
		return
	end

	local root = selection[1]

	-- Build typed tree
	local typedTree = buildTypedTree(root)
	local lines = formatTypeTree("Instance", typedTree, "Instance", "", true)

	-- Wrap in comment block with VS Code note
	local header = {
		"-- GENERATED Instance TYPE",
		"-- Copy the block below into your type annotations (Luau)",
		"-- with this use the type on any Instance and vs code will show you autocomplete like the Robloc=x script editor",
		"-- Generated by Typed Instance Plugin",
		"--[["
	}
	local footer = {"--]]"}

	local full = {}
	for _, l in ipairs(header) do table.insert(full, l) end
	for _, l in ipairs(lines) do table.insert(full, l) end
	for _, l in ipairs(footer) do table.insert(full, l) end

	local outputText = table.concat(full, "\n")

	-- Save to ModuleScript
	local folder = ReplicatedStorage:FindFirstChild("GeneratedTypes") or Instance.new("Folder")
	if folder.Parent == nil then
		folder.Name = "GeneratedTypes"
		folder.Parent = ReplicatedStorage
	end

	local module = Instance.new("ModuleScript")
	module.Name = "TypedInstance_" .. math.random(1,999999)
	module.Source = outputText
	module.Parent = folder

	print("✅ Typed Instance ModuleScript created in ReplicatedStorage.GeneratedTypes")
end)
